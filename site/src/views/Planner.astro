---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Faq from '../components/Faq.astro';
import ToolkitCta from '../components/ToolkitCta.astro';
import YearEndPlanner from '../components/islands/YearEndPlanner';
import { RELIEF_META } from '../data/reliefMeta';
import { CONFIG } from '../config';
import { absolute, href } from '../i18n/paths';
import { tri } from '../i18n/tri';
import { t } from '../i18n/ui';
import { appLd, faqLd } from '../lib/jsonld';
import { metaLite } from '../lib/metaLite';
import type { Lang } from '../lib/tax/types';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const L = tri(lang);
const path = 'year-end-planner/';
const title = L(
  '年底省税规划器：12 月 31 日前还能省多少税？',
  'Year-End Tax Planner Malaysia: Save Tax Before 31 December',
  'Perancang Cukai Hujung Tahun: Jimat Cukai Sebelum 31 Disember',
);
const description = L(
  '输入收入和今年已花的钱，马上看到每一项 YA2026 减免还剩多少额度、用满能省多少税，按省税金额排序。',
  'Enter your income and what you have spent this year to see how much of each YA2026 relief is left and how much tax you save by using it, ranked by saving.',
  'Masukkan pendapatan dan perbelanjaan anda tahun ini untuk melihat baki setiap pelepasan YA2026 dan berapa cukai yang dijimatkan jika digunakan sepenuhnya, disusun ikut penjimatan.',
);
const yearEndIds = new Set(RELIEF_META.filter((m) => m.yearEnd).map((m) => m.id));

const faqs = L(
  [
    { q: '为什么要在 12 月 31 日前完成？', a: '减免是按「付款年份」计算的。2026 年 12 月 31 日前付的钱算 YA2026；1 月 1 日之后付的就要等到 YA2027 才能报。' },
    { q: '花 RM100 能省多少税？', a: '等于你的边际税率。边际税率 6% 就省 RM6，19% 就省 RM19。所以减免对高收入的人更有用，低收入的人不必为了减免而消费。' },
    { q: '最划算的年底省税方法是什么？', a: '先用「本来就要花的钱」：手机/电脑/网络费（生活方式）、体检和疫苗（医药）、运动开销。再考虑储蓄型的：PRS（RM3,000）和 SSPN（RM8,000）——钱还是你的，只是存起来。' },
    { q: '收据要保留多久？', a: '报税时不需要上传收据，但 LHDN 可能在 7 年内要求查看，所以请保留 7 年。买东西时可以要 e-Invoice（提供身份证号码），方便以后报税。' },
  ],
  [
    { q: 'Why does it have to be done by 31 December?', a: 'Reliefs follow the year you pay. Money paid by 31 December 2026 counts for YA2026; anything paid from 1 January goes into YA2027.' },
    { q: 'How much tax does RM100 of spending save?', a: 'Your marginal rate: RM6 at 6%, RM19 at 19%. Reliefs matter most to higher earners — lower earners shouldn’t spend just for a relief.' },
    { q: 'What are the best year-end moves?', a: 'Start with spending you would do anyway: phone, laptop and internet (lifestyle), check-ups and vaccines (medical), sports. Then savings-type reliefs: PRS (RM3,000) and SSPN (RM8,000) — the money stays yours.' },
    { q: 'How long should I keep receipts?', a: 'You don’t upload receipts when filing, but LHDN can ask for them for 7 years. Ask for an e-Invoice (give your IC number) to make filing easier.' },
  ],
  [
    { q: 'Kenapa perlu dibuat sebelum 31 Disember?', a: 'Pelepasan mengikut tahun bayaran dibuat. Wang yang dibayar sebelum 31 Disember 2026 dikira untuk YA2026; apa-apa yang dibayar mulai 1 Januari masuk ke YA2027.' },
    { q: 'Berapa cukai dijimatkan dengan belanja RM100?', a: 'Bersamaan kadar marginal anda: RM6 pada 6%, RM19 pada 19%. Pelepasan paling bermakna untuk mereka berpendapatan tinggi — yang berpendapatan rendah tidak perlu berbelanja semata-mata untuk pelepasan.' },
    { q: 'Apakah langkah hujung tahun yang terbaik?', a: 'Mulakan dengan perbelanjaan yang memang akan dibuat: telefon, komputer riba dan internet (gaya hidup), pemeriksaan kesihatan dan vaksin (perubatan), sukan. Kemudian pelepasan jenis simpanan: PRS (RM3,000) dan SSPN (RM8,000) — wang tetap milik anda.' },
    { q: 'Berapa lama resit perlu disimpan?', a: 'Anda tidak perlu memuat naik resit semasa memfailkan cukai, tetapi LHDN boleh memintanya dalam tempoh 7 tahun. Minta e-Invois (berikan nombor kad pengenalan) supaya pemfailan lebih mudah.' },
  ],
);
const url = absolute(href(lang, path), Astro.site);
---

<Base lang={lang} title={title} description={description} path={path} jsonLd={[appLd(title, description, url, lang), faqLd(faqs)]}>
  <PageHeader
    lang={lang}
    title={title}
    intro={L(
      'YA2026 的减免只算 2026 年 12 月 31 日前付的钱。这个工具会告诉你每一项减免还剩多少额度、用满能省多少税，最省的排在最前面。',
      'YA2026 reliefs only count money paid by 31 December 2026. This tool shows how much of each relief you have left and how much tax filling it would save — biggest savings first.',
      'Pelepasan YA2026 hanya mengira wang yang dibayar sebelum 31 Disember 2026. Alat ini menunjukkan baki setiap pelepasan dan berapa cukai yang dijimatkan jika digunakan sepenuhnya — penjimatan terbesar di atas.',
    )}
    crumbs={[{ label: t(lang, 'nav.planner'), path }]}
  />
  <div class="max-w-5xl mx-auto px-4 py-8">
    <YearEndPlanner
      client:load
      lang={lang}
      meta={metaLite(lang, (id) => yearEndIds.has(id))}
      reliefsBase={href(lang, 'reliefs/')}
      toolkitUrl={CONFIG.toolkitUrl}
      toolkitPrice={CONFIG.toolkitPrice}
    />
    <article class="prose-lite mt-12 max-w-3xl">
      <h2>{L('年底省税清单', 'Year-end checklist', 'Senarai semak hujung tahun')}</h2>
      <p>
        {L('想看每一招的详细说明？读', 'Want the details for each move? Read', 'Mahu butiran setiap langkah? Baca')}{' '}
        <a href={href(lang, 'guides/year-end-tax-tips/')}>
          {L('《2026 年底省税 12 招》', '12 ways to cut your tax before 31 December', '12 cara jimat cukai sebelum 31 Disember')}
        </a>{L('。', '.', '.')}
      </p>
    </article>
    <ToolkitCta lang={lang} />
    <Faq title={L('常见问题', 'FAQ', 'Soalan lazim')} items={faqs} />
  </div>
</Base>
