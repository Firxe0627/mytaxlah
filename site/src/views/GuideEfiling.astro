---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Faq from '../components/Faq.astro';
import ToolkitCta from '../components/ToolkitCta.astro';
import { CONFIG } from '../config';
import { absolute, href } from '../i18n/paths';
import { t } from '../i18n/ui';
import { articleLd, faqLd } from '../lib/jsonld';
import type { Lang } from '../lib/tax/types';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const zh = lang === 'zh';
const path = 'guides/e-filing/';
const title = zh ? 'e-Filing 报税教程：YA2026 怎么在 MyTax 报个人所得税（2027）' : 'How to File Your Malaysian Income Tax Online (e-Filing YA2026, 2027 Guide)';
const description = zh
  ? '第一次报税也看得懂：确认税号、首次登录 MyTax、填写 e-BE 表格、报减免、提交和查退税。附截止日期和准备清单。'
  : 'A plain-language guide to filing Form BE on MyTax: checking your tax number, first login, filling in e-BE, claiming reliefs, submitting and tracking your refund.';

const steps = zh
  ? [
      { h: '准备资料', p: '雇主发的 EA 表格（每年 2 月底前发出）、各项减免的收据或结单（保险、PRS、SSPN、医药、生活方式等）、银行户口号码（用来收退税）。' },
      { h: '确认你的税号（TIN）', p: '2023 年起，18 岁以上的马来西亚公民和永久居民会自动获得税号。在 MyTax 网站输入身份证号码就能查。没有的话，用 MyTax 上的 e-Daftar 在线登记。' },
      { h: '第一次登录 MyTax', p: '首次登录需要 PIN 号码，可以通过 MyTax 的 e-KYC（手机拍身份证和自拍）、在线申请，或到 LHDN 分行领取。拿到后在「First Time Login」设置自己的密码和安全图片。' },
      { h: '打开 e-BE 表格', p: '登录后选择 ezHASiL Services → e-Filing → e-Form，选「e-BE」（没有生意收入的税务居民）和课税年 2026。有生意收入的要用 e-B。' },
      { h: '核对个人资料', p: '确认地址、婚姻状况、银行资料。配偶没有收入或选择联合报税的话，这里要选对。' },
      { h: '填写收入', p: '照 EA 表格填就业收入（花红、津贴都在 EA 上）。如有租金、兼职等其他收入也要填。' },
      { h: '填写减免', p: '逐项填入减免金额。系统只会帮你填个人减免，其他都要自己填——这是多数人少报的地方。不确定能报什么？对照本站的减免清单。' },
      { h: '填写已扣的 PCB 和天课', p: 'PCB 总额在 EA 表格上。系统会自动算出你要补税还是退税。' },
      { h: '检查并签名提交', p: '在摘要页检查一遍，用密码作数字签名后提交，保存或打印确认收据（acknowledgement）。' },
      { h: '查退税', p: '多扣的税会退到你填的银行户口。可以在 MyTax 查看状态。' },
    ]
  : [
      { h: 'Gather your documents', p: 'Your EA form from your employer (issued by the end of February), receipts or statements for reliefs (insurance, PRS, SSPN, medical, lifestyle…) and your bank account number for refunds.' },
      { h: 'Check your tax number (TIN)', p: 'Since 2023, Malaysian citizens and PRs aged 18+ are given a TIN automatically. Enter your IC number on MyTax to check. If you have none, register online with e-Daftar.' },
      { h: 'Log in to MyTax for the first time', p: 'A first-time login needs a PIN, which you can get through e-KYC in MyTax (photo of your IC plus a selfie), an online request, or at an LHDN branch. Then use “First Time Login” to set your password and security image.' },
      { h: 'Open the e-BE form', p: 'Go to ezHASiL Services → e-Filing → e-Form and choose “e-BE” (residents without business income) for Year of Assessment 2026. If you have business income, use e-B.' },
      { h: 'Check your personal details', p: 'Confirm your address, marital status and bank details. If your spouse has no income or you elect joint assessment, set it here.' },
      { h: 'Enter your income', p: 'Copy employment income from your EA form (bonus and allowances are already on it). Add other income such as rent or side work.' },
      { h: 'Enter your reliefs', p: 'Fill in each relief. Only the individual relief is filled in for you — the rest is up to you, and it’s where most people under-claim. Unsure what counts? Check our relief list.' },
      { h: 'Enter PCB and zakat already paid', p: 'Total PCB is on the EA form. The system then shows whether you owe tax or get a refund.' },
      { h: 'Review, sign and submit', p: 'Check the summary page, sign digitally with your password, submit, and save the acknowledgement receipt.' },
      { h: 'Track your refund', p: 'Over-deducted tax is refunded to the bank account you entered. You can follow the status on MyTax.' },
    ];

const faqs = zh
  ? [
      { q: 'YA2026 什么时候可以报？截止日期是？', a: '除非 LHDN 另行宣布，e-Filing 一般在每年 3 月 1 日开放。BE 表格的截止日期是 4 月 30 日，用 e-Filing 通常有宽限到 5 月 15 日。以 LHDN 公布为准。' },
      { q: '收据要上传吗？', a: '不用。但要保留 7 年，LHDN 抽查时要能拿出来。' },
      { q: '迟交会怎样？', a: '迟交或少报都可能被罚款。来不及的话，先提交、之后再用修正申报（amended return）补正，比不交好。' },
      { q: 'e-Invoice 和报税有什么关系？', a: 'LHDN 鼓励买东西时要求 e-Invoice（提供身份证号码），并正在试行用 e-Invoice 资料为 YA2026 自动预填减免。即使有预填，也要自己核对。' },
    ]
  : [
      { q: 'When can I file YA2026, and what’s the deadline?', a: 'Unless LHDN says otherwise, e-Filing opens on 1 March. The Form BE deadline is 30 April, usually with an e-Filing grace period to 15 May. Check LHDN’s announcement.' },
      { q: 'Do I upload receipts?', a: 'No, but keep them for 7 years in case LHDN audits you.' },
      { q: 'What happens if I file late?', a: 'Late filing or under-reporting can lead to penalties. If you’re short on time, file first and correct it with an amended return later.' },
      { q: 'What does e-Invoice have to do with filing?', a: 'LHDN encourages you to request e-Invoices (give your IC number) and is piloting pre-filled reliefs from e-Invoice data for YA2026. Always check pre-filled figures yourself.' },
    ];
const url = absolute(href(lang, path), Astro.site);
---

<Base lang={lang} title={title} description={description} path={path} ogType="article" jsonLd={[articleLd(title, description, url, lang, CONFIG.updated), faqLd(faqs)]}>
  <PageHeader
    lang={lang}
    title={title}
    intro={zh ? 'YA2026（2026 年的收入）在 2027 年 3 月开始报。只有薪水收入的人用 e-BE 表格，整个过程大约 20–30 分钟。' : 'YA2026 (income earned in 2026) is filed from March 2027. If you only have a salary you use Form e-BE — it takes about 20–30 minutes.'}
    crumbs={[
      { label: t(lang, 'nav.guides'), path: 'guides/' },
      { label: 'e-Filing', path },
    ]}
  />
  <div class="max-w-5xl mx-auto px-4 py-8">
    <article class="prose-lite max-w-3xl">
      <p class="text-sm bg-amber-50 border border-amber-200 rounded-lg p-3">
        {zh
          ? 'MyTax 的画面和登录方式偶尔会更新。本文以流程为主，具体按钮名称以 MyTax 网站为准。'
          : 'MyTax screens and login methods change from time to time. This guide focuses on the flow — follow the labels on the MyTax site.'}
      </p>
      {
        steps.map((s, i) => (
          <section>
            <h2>
              {zh ? `第 ${i + 1} 步：` : `Step ${i + 1}: `}
              {s.h}
            </h2>
            <p>{s.p}</p>
          </section>
        ))
      }
      <h2>{zh ? '报税前先算一次' : 'Run the numbers before you file'}</h2>
      <p>
        {zh ? '用' : 'Use the'} <a href={href(lang, 'tax-calculator/')}>{zh ? '个税计算器' : 'tax calculator'}</a>
        {zh ? '先把减免填一遍，就知道大概会退多少，也能确认有没有漏报。' : ' with your reliefs first — you’ll know roughly what refund to expect and spot anything you missed.'}
      </p>
    </article>
    <ToolkitCta lang={lang} />
    <Faq title={zh ? '常见问题' : 'FAQ'} items={faqs} />
    <p class="mt-8 text-sm text-slate-600">
      {zh ? '官方网站：' : 'Official site: '}
      <a class="underline" href="https://mytax.hasil.gov.my/" rel="noopener" target="_blank">mytax.hasil.gov.my</a>
    </p>
  </div>
</Base>
