---
import { href } from '../i18n/paths';
import { t } from '../i18n/ui';
import type { Lang } from '../lib/tax/types';

interface Props {
  lang: Lang;
  title: string;
  intro?: string;
  crumbs?: { label: string; path: string }[];
}
const { lang, title, intro, crumbs = [] } = Astro.props;
---

<div class="bg-white border-b border-slate-200">
  <div class="max-w-5xl mx-auto px-4 pt-6 pb-8">
    {
      crumbs.length > 0 && (
        <nav class="text-xs text-slate-500 mb-3" aria-label="Breadcrumb">
          <a href={href(lang)} class="hover:text-emerald-700">
            {t(lang, 'nav.home')}
          </a>
          {crumbs.map((c) => (
            <>
              <span class="mx-1.5">/</span>
              <a href={href(lang, c.path)} class="hover:text-emerald-700">
                {c.label}
              </a>
            </>
          ))}
        </nav>
      )
    }
    <h1 class="text-2xl md:text-3xl font-extrabold text-slate-900 leading-tight">{title}</h1>
    {intro && <p class="mt-3 text-slate-600 max-w-3xl leading-relaxed">{intro}</p>}
    <slot />
  </div>
</div>
