---
import { CONFIG } from '../config';
import type { Lang } from '../lib/tax/types';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const zh = lang === 'zh';
---

{
  CONFIG.toolkitUrl && (
    <aside class="my-10 rounded-2xl border-2 border-emerald-600 bg-white p-6">
      <p class="text-xs font-semibold tracking-wide text-emerald-700 uppercase">{zh ? '付费工具包' : 'Paid toolkit'}</p>
      <p class="mt-1 text-lg font-bold text-slate-900">{zh ? 'YA2026 报税 + 省税工具包' : 'YA2026 Tax Filing & Saving Toolkit'}</p>
      <ul class="mt-3 text-sm text-slate-700 space-y-1.5 list-disc pl-5">
        <li>{zh ? 'Excel 省税规划表：填入开销，自动算出可扣额度和税额' : 'Excel planner: enter your spending, it works out reliefs and tax'}</li>
        <li>{zh ? '每一项减免要保留的收据清单（LHDN 查账时用）' : 'Receipts checklist for every relief (for LHDN audits)'}</li>
        <li>{zh ? 'MyTax e-Filing（BE 表格）中文逐步教程' : 'Step-by-step MyTax e-Filing guide (Form BE)'}</li>
      </ul>
      <a
        href={CONFIG.toolkitUrl}
        target="_blank"
        rel="noopener"
        class="inline-block mt-4 px-5 py-2.5 rounded-lg bg-emerald-600 text-white font-semibold hover:bg-emerald-700"
      >
        {zh ? `获取工具包 ${CONFIG.toolkitPrice}` : `Get it for ${CONFIG.toolkitPrice}`}
      </a>
    </aside>
  )
}
